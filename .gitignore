# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.moved-aside

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/

# Models: scaffolds (~1 MB total) are committed; weight.bin files are
# downloaded on first launch via ModelManager.
python-server/models/*.pt
python-server/models/*.pth
apps/mac-client/SuperPickyInference/Resources/Models/*.mlmodelc/weights/weight.bin
# CoreML source packages (~420 MB total) — never committed
apps/mac-client/SuperPickyInference/Resources/Models/*.mlpackage/

# macOS
.DS_Store
*.swp
*~

# Superpowers
.superpowers/
real-photos/

# Claude Code local state
.claude/

# Git worktrees
.worktrees/

# User-picked photo output
Picked/

# test-photos runtime artifacts (per-folder DB + XMP sidecars written by the
# app). Fixture JPGs are tracked; sidecars + DBs only appear if you point the
# real app at the fixture directory.
apps/mac-client/SuperPickyUITests/test-photos*/.report.db*
apps/mac-client/SuperPickyUITests/test-photos*/.DS_Store
apps/mac-client/SuperPickyUITests/test-photos*/*.xmp

# Root-level scratch dir used for ad-hoc app runs against the fixtures.
/test-photos/

# LLVM coverage / profiling output
*.profraw
